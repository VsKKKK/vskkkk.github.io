---
import SiteLayout from '../layouts/SiteLayout.astro';
import SelectedWorks from '../components/SelectedWorks.astro';
import BackToTop from '../components/BackToTop.astro';
import '../styles/home.css';

const skills = [
  { title: 'Product Thinking', icon: '◎', text: '从业务角色与任务出发，梳理需求、流程和设计优先级。' },
  { title: 'UX / UI Design', icon: '↗', text: '把复杂操作拆成清楚的路径，设计界面层级、状态与反馈。' },
  { title: 'Design Systems', icon: '▦', text: '整理组件、样式和交互规则，让设计与实现保持一致。' },
  { title: 'AI Workflow', icon: '✦', text: '用 AI 辅助研究、素材审查和原型验证，并检查产出质量。' },
];

const tools = [
  { title: 'ChatGPT', text: '梳理产品问题、组织案例材料与推敲页面文案。' },
  { title: 'Codex', text: '搭建 Astro 页面，检查素材、交互和响应式表现。' },
  { title: 'Figma Make', text: '搭建交互原型，验证界面结构与关键流程。' },
];

const notes = [
  '从运营任务出发，梳理复杂后台的信息层级',
  '组件与状态规范如何支持内容运营',
  '同一张作品图在桌面与手机上的可读性',
];
---
<SiteLayout title="Portfolio">


  <section class="site-shell home-hero" aria-labelledby="hero-title">
    <h1 id="hero-title">Portfolio</h1>
    <p>我是 Keyin，一名 UX/UI 设计师。<br />这里收录我的产品体验与界面设计作品。</p>
    <div class="home-hero-actions">
      <button class="button-pill" type="button" data-contact-trigger aria-haspopup="dialog" aria-controls="contact-modal">联系我</button>
      <a class="button-pill button-primary" href="#works">查看作品</a>
    </div>
  </section>

  <SelectedWorks />

  <section class="site-shell home-section home-skills" aria-labelledby="skills-title">
    <h2 id="skills-title">Core Skills</h2>
    <ul class="home-skills-grid">
      {skills.map(({ title, icon, text }) => (
        <li>
          <span aria-hidden="true">{icon}</span>
          <div>
            <h3>{title}</h3>
            <p>{text}</p>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <section class="site-shell home-section home-tools" aria-labelledby="tools-title">
    <h2 id="tools-title">AI Tools</h2>
    <div class="home-tools-grid">
      {tools.map(({ title, text }) => (
        <article class="home-tool">
          <h3 class="home-tool-mark">{title}</h3>
          <p>{text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="site-shell home-section home-notes" aria-labelledby="notes-title">
    <h2 id="notes-title">Design Notes</h2>
    <ol>
      {notes.map((note, index) => (
        <li><span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span><p>{note}</p></li>
      ))}
    </ol>
  </section>

  <BackToTop />
</SiteLayout>
