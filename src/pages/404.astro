---
import Preloader from '../components/Preloader.astro';
import CopyButton from '../components/CopyButton.astro';
import { site } from '../data/site';
import '../styles/global.css';

const endpoint = import.meta.env.PUBLIC_404_FEEDBACK_URL?.trim() ?? '';
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex" />
    <title>{site.title}</title>
  </head>
  <body class="error-page">
    <Preloader />
    <header class="error-header">
      <a href="/">{site.name}</a>
      <span>404</span>
    </header>
    <main class="error-main">
      <section class="error-hero" aria-labelledby="error-title">
        <p class="error-code" aria-hidden="true">404</p>
        <h1 id="error-title">页面似乎走丢了</h1>
        <p>你访问的页面不存在、已被移动，或链接地址有误。</p>
        <div class="feedback" data-endpoint={endpoint}>
          <div class="error-actions" data-report-actions>
            <button type="button" class="error-button primary" data-report>反馈此问题</button>
            <a class="error-button" href="/">返回首页</a>
          </div>
          <p class="feedback-message" role="status" data-feedback-status></p>
          <div class="feedback-result" data-report-result hidden>
            <p class="result-title" tabindex="-1">问题反馈成功！</p>
            <p>感谢你的反馈，我已经收到这条报告，会尽快检查并处理。</p>
            <p class="report-number">报告编号 <code id="copy-report-id" data-report-id></code></p>
            <div class="error-actions">
              <CopyButton class="error-button primary" label="复制报告编号" sourceId="copy-report-id" successMessage="报告编号已复制" errorMessage="请选中报告编号手动复制。" />
              <a class="error-button" href="/">返回首页</a>
            </div>
          </div>
          <noscript><p>请通过下方联系方式联系我。</p></noscript>
        </div>
        <p class="error-note">如果你认为这是一个问题，可以一键反馈给我，我会尽快处理。</p>
      </section>

      <section class="error-contact" aria-labelledby="error-contact-title">
        <h2 id="error-contact-title">直接联系我</h2>
        <div class="contact-email">
          <a href={`mailto:${site.email}`}>{site.email}</a>
          <CopyButton class="error-button copy-email" label="复制邮箱" text={site.email} successMessage="邮箱已复制" errorMessage="无法自动复制，请选中邮箱地址手动复制。" />
        </div>
        <figure class="wechat-qr">
          <img src={site.wechatQr} width="665" height="665" alt="微信二维码" decoding="async" />
          <figcaption>微信扫码添加好友</figcaption>
        </figure>
      </section>
    </main>
    <script>

      const feedback = document.querySelector<HTMLElement>('.feedback')!;
      const report = document.querySelector<HTMLButtonElement>('[data-report]')!;
      const status = document.querySelector<HTMLElement>('[data-feedback-status]')!;
      const result = document.querySelector<HTMLElement>('[data-report-result]')!;
      const reportId = document.querySelector<HTMLElement>('[data-report-id]')!;
      let requestId: string | undefined;

      function safeUrl(value: string) {
        if (!value) return '';
        const url = new URL(value);
        return url.origin + url.pathname;
      }

      report.addEventListener('click', async () => {
        if (report.disabled || !result.hidden) return;
        const endpoint = feedback.dataset.endpoint;
        if (!endpoint) {
          status.textContent = '在线反馈暂未接通，请通过下方联系方式联系我。';
          return;
        }
        report.disabled = true;
        report.textContent = '正在提交…';
        status.textContent = '正在提交反馈…';
        try {
          requestId ??= crypto.randomUUID();
          const response = await fetch(endpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'omit',
            referrerPolicy: 'no-referrer',
            signal: AbortSignal.timeout(12000),
            body: JSON.stringify({
              requestId,
              url: safeUrl(location.href),
              referrer: safeUrl(document.referrer),
              screen: [screen.width, screen.height],
            }),
          });
          if (response.status === 429) {
            status.textContent = '反馈提交过于频繁，请稍后重试。';
            return;
          }
          const data = await response.json();
          if (!response.ok || !/^404-\d{8}-[A-F0-9]{8}$/.test(data.id)) throw new Error('Report was not saved');
          status.textContent = '';
          reportId.textContent = data.id;
          document.querySelector<HTMLElement>('[data-report-actions]')!.hidden = true;
          result.hidden = false;
          result.querySelector<HTMLElement>('.result-title')?.focus({ preventScroll: true });
        } catch {
          status.textContent = '暂时无法提交反馈，请稍后重试，或通过下方联系方式联系我。';
        } finally {
          report.textContent = '反馈此问题';
          report.disabled = !result.hidden;
        }
      });

    </script>
  </body>
</html>

<style>
  .error-page {
    color-scheme: dark;
    display: flex;
    flex-direction: column;
    height: auto;
    min-height: 100dvh;
    overflow: visible;
    padding: env(safe-area-inset-top) max(24px, env(safe-area-inset-right)) env(safe-area-inset-bottom) max(24px, env(safe-area-inset-left));
    background: #0a0a0a;
    color: #f5f5f5;
  }
  .error-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: min(100%, 1550px);
    margin-inline: auto;
    padding-block: clamp(16px, 3vh, 32px);
  }
  .error-header a { font-size: 24px; font-weight: 650; letter-spacing: -.04em; text-decoration: none; }
  .error-header span { color: #aaa; font-size: 14px; letter-spacing: .08em; }
  .error-main {
    width: min(100%, 1240px);
    margin: auto;
    padding-block: 28px clamp(52px, 8vh, 88px);
  }
  .error-hero {
    text-align: center;
  }
  .error-hero .error-code {
    color: #f5f5f5;
    font-size: clamp(96px, 10vw, 164px);
    font-weight: 400;
    font-variant-numeric: lining-nums tabular-nums;
    line-height: 1;
    letter-spacing: -.04em;
  }
  h1 { font-size: clamp(30px, 3.3vw, 48px); line-height: 1.22; font-weight: 500; margin-block: 8px 12px; }
  .error-hero p { color: #bdbdbd; }
  .error-hero > p:not(.error-code, .error-note) { font-size: clamp(16px, 1.5vw, 22px); }
  .error-note, .error-hero .error-note { color: #a6a6a6; font-size: clamp(15px, 1.25vw, 18px); }
  .error-hero > .error-note { margin: 14px auto 0; max-width: 42rem; }
  .feedback { margin: 20px auto 0; max-width: 620px; }
  .error-actions { display: flex; justify-content: center; gap: 16px; }
  .error-actions[hidden] { display: none; }
  .error-button {
    display: inline-flex; align-items: center; justify-content: center;
    min-width: 178px; min-height: 54px; border: 1px solid #777; border-radius: var(--radius-pill);
    padding: 0 24px; background: transparent; color: inherit; text-decoration: none;
    font: inherit; font-size: 17px; cursor: pointer;
  }
  .error-button:hover { border-color: #eee; }
  .error-button:focus-visible, a:focus-visible { outline-color: #b9b9ff; }
  .error-button.primary { background: #f5f5f5; color: #101010; border-color: #f5f5f5; font-weight: 550; }
  .error-button:disabled { opacity: .65; cursor: wait; }
  .feedback-message:not(:empty) { margin-top: 12px; font-size: 15px; }
  .feedback-result .result-title { margin-bottom: 8px; color: #fff; font-size: 24px; }
  .feedback-result .report-number { margin: 12px 0 18px; }
  .report-number code { margin-left: 6px; color: #fff; }
  .error-contact {
    width: min(100%, 680px);
    margin: clamp(28px, 4vh, 44px) auto 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, max-content));
    justify-content: center;
    align-items: center;
    gap: 10px 44px;
  }
  .error-contact h2 {
    grid-column: 1 / -1; text-align: center;
    color: #bdbdbd; font-size: 16px; font-weight: 500;
  }
  .error-contact .contact-email {
    display: grid;
    justify-items: start;
    gap: 6px;
    min-width: 0;
  }
  .contact-email a { font-size: 15px; overflow-wrap: anywhere; text-underline-offset: .2em; }
  .error-button.copy-email { min-width: 0; min-height: 44px; padding-inline: 13px; font-size: 14px; }
  .error-button.copy-email { --copy-success-color: #b9b9ff; }
  .wechat-qr { display: grid; justify-items: center; gap: 6px; margin: 0; }
  .wechat-qr img { display: block; width: 108px; max-width: 100%; height: auto; border-radius: 6px; }
  .wechat-qr figcaption { color: #bdbdbd; font-size: 13px; text-align: center; }
  @media (max-width: 640px) {
    .error-header { padding-block: 14px; }
    .error-header a { font-size: 21px; }
    .error-page {
      padding-inline: max(16px, env(safe-area-inset-left)) max(16px, env(safe-area-inset-right));
    }
    .error-main { margin-block: 0 auto; padding-block: clamp(24px, 6vh, 52px) 24px; }
    .error-hero .error-code { font-size: clamp(74px, 21vw, 96px); }
    h1 { font-size: clamp(27px, 7.7vw, 32px); margin-block: 7px 10px; }
    .error-hero > p:not(.error-code, .error-note) { font-size: 15px; }
    .error-hero > .error-note { margin-top: 12px; font-size: 13px; }
    .feedback { margin-top: 16px; }
    .error-actions { flex-direction: column; gap: 8px; width: min(100%, 360px); margin-inline: auto; }
    .error-button { min-height: 44px; min-width: 0; font-size: 15px; }
    .error-contact { width: min(100%, 360px); grid-template-columns: minmax(0, 1fr) max-content; gap: 8px 14px; margin-top: 24px; }
    .error-contact h2 { text-align: left; font-size: 16px; }
    .wechat-qr img { width: 100px; }
    .wechat-qr figcaption { font-size: 12px; }
  }
</style>
