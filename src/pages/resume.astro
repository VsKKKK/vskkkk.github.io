---
import { Image } from 'astro:assets';
import portrait from '../assets/keyin-portrait.jpg';
import SiteLayout from '../layouts/SiteLayout.astro';
import { resume } from '../data/resume';
import { site } from '../data/site';
---

<SiteLayout>
  <div class="site-shell resume">
    <div class="resume-actions">
      <a class="text-link" href="/about/">返回 About</a>
      <a class="button-pill button-primary" href="/resume/keyin-li-resume.pdf" download="李可茵-简历.pdf" data-track-resume>下载 PDF</a>
    </div>

    <div class="resume-print-page">
      <header class="resume-profile">
        <div>
          <p class="resume-profile-label"><span aria-hidden="true">01</span> 个人资料</p>
          <h1>{resume.name}</h1>
          <p class="resume-role">{resume.role}</p>
          <p class="resume-focus">{resume.focus}</p>
          <div class="resume-contact">
            <p>{resume.location} <span aria-hidden="true">·</span> {resume.experience}</p>
            <a class="text-link" href={`mailto:${site.email}`}>{site.email}</a>
          </div>
        </div>
        <Image src={portrait} alt="李可茵的个人照片" class="resume-portrait"
          width={420} format="webp" quality={90} loading="eager" />
      </header>

      <section aria-labelledby="strengths-title">
        <h2 id="strengths-title"><span aria-hidden="true">02</span> 个人优势</h2>
        <dl class="resume-facts">
          {resume.strengths.map(({ title, detail }) => (
            <div><dt>{title}</dt><dd>{detail}</dd></div>
          ))}
        </dl>
      </section>

      <section aria-labelledby="employment-title">
        <h2 id="employment-title"><span aria-hidden="true">03</span> 工作经历</h2>
        <ol class="resume-timeline" role="list">
          {resume.employment.map(({ company, role, dates, duties }) => (
            <li>
              <header class="resume-entry">
                <h3>{company}</h3>
                <div class="resume-entry-meta"><span>{role}</span><span class="resume-date">{dates}</span></div>
              </header>
              <ul class="resume-duties">
                {duties.map((duty) => <li>{duty}</li>)}
              </ul>
            </li>
          ))}
        </ol>
      </section>
      <p class="resume-folio">01 / 02</p>
    </div>

    <div class="resume-print-page">
      <header class="resume-running">
        <strong>{resume.name}</strong>
        <span>{resume.role}</span>
      </header>

      <section aria-labelledby="projects-title">
        <h2 id="projects-title"><span aria-hidden="true">04</span> 重点项目</h2>
        <ul class="resume-timeline" role="list">
          {resume.projects.map(({ name, role, dates, context, contributions }) => (
            <li>
              <header class="resume-entry">
                <h3>{name}</h3>
                <div class="resume-entry-meta"><span>{role}</span>{dates && <span class="resume-date">{dates}</span>}</div>
              </header>
              <p class="resume-project-context">{context}</p>
              <ul class="resume-duties">
                {contributions.map((item) => <li>{item}</li>)}
              </ul>
            </li>
          ))}
        </ul>
      </section>

      <section aria-labelledby="research-title">
        <h2 id="research-title"><span aria-hidden="true">05</span> 其他研究项目</h2>
        <ul class="resume-research">
          {resume.research.map(({ title, detail }) => (
            <li><h3>{title}</h3><p>{detail}</p></li>
          ))}
        </ul>
      </section>

      <section aria-labelledby="skills-title">
        <h2 id="skills-title"><span aria-hidden="true">06</span> 工作技能</h2>
        <dl class="resume-facts">
          {resume.skills.map(({ title, items }) => (
            <div>
              <dt>{title}</dt>
              <dd>{items.map((item, index) => (
                <><span class="resume-skill">{item}{index < items.length - 1 ? '、' : ''}</span><wbr /></>
              ))}</dd>
            </div>
          ))}
        </dl>
      </section>
      <p class="resume-folio">02 / 02</p>
    </div>
  </div>
</SiteLayout>

<style>
  .resume {
    --shell-width: 1140px;
    padding-block: 30px 58px;
    font-size: 16px;
    line-height: 1.8;
    overflow-wrap: anywhere;
  }
  .resume-actions, .resume-profile, .resume-running {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 10px 24px;
  }
  .resume-actions { align-items: center; font-size: 14px; }
  .resume-print-page { display: contents; }
  .resume-running, .resume-folio { display: none; }
  .resume-profile {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 22px 48px;
    padding-block: clamp(42px, 6vw, 80px);
  }
  .resume-focus { max-width: 42em; margin-top: 9px; }
  .resume-profile-label, .resume h2 span { font-size: 12px; font-weight: 600; font-variant-numeric: tabular-nums; }
  .resume-profile-label { margin-bottom: 10px; color: var(--text-secondary); }
  .resume-profile-label span, .resume h2 span { margin-right: 8px; color: var(--accent); }
  .resume h1 { font-size: clamp(44px, 6vw, 76px); line-height: 1.1; letter-spacing: -.05em; }
  .resume-role { margin-top: 10px; font-size: 20px; font-weight: 650; }
  .resume-portrait {
    display: block;
    width: clamp(180px, 14vw, 196px);
    height: auto;
    aspect-ratio: 3 / 4;
    border-radius: 8px;
    object-fit: cover;
    object-position: center;
  }
  .resume-contact { margin-top: 18px; }
  .resume-contact a { color: inherit; }
  .resume-focus, .resume-contact, .resume-facts dd, .resume-entry-meta, .resume-project-context, .resume-research p {
    color: var(--text-secondary);
  }
  .resume section {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 3.5fr);
    align-items: start;
    gap: 22px 40px;
    padding-block: clamp(32px, 5vw, 66px);
    border-top: 1px solid var(--line);
  }
  .resume h2 { font-size: clamp(23px, 2.3vw, 32px); line-height: 1.25; }
  .resume h2 span { vertical-align: .2em; }
  .resume h3 { font-size: 18px; font-weight: 650; line-height: 1.45; }
  .resume-facts { display: grid; gap: 12px; margin: 0; }
  .resume-facts > div { display: grid; grid-template-columns: minmax(0, 10em) minmax(0, 1fr); gap: 3px 12px; }
  .resume-facts dt { font-weight: 600; }
  .resume-facts dd { margin: 0; }
  .resume-skill { white-space: nowrap; }
  .resume-timeline, .resume-research { list-style: none; margin: 0; padding: 0; }
  .resume-timeline { margin-left: 4px; padding-left: 18px; border-left: 1px solid var(--accent); }
  .resume-timeline > li { position: relative; }
  .resume-timeline > li + li { margin-top: 26px; }
  .resume-timeline > li::before {
    content: '';
    position: absolute;
    top: .72em;
    left: -22px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
  }
  .resume-entry {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 4px 12px;
  }
  .resume-entry-meta {
    display: grid;
    grid-template-columns: 10em 10em;
    gap: 3px 12px;
    font-size: 14px;
    text-align: end;
  }
  .resume-date { white-space: nowrap; font-variant-numeric: tabular-nums; }
  .resume-duties { margin: 7px 0 0; padding-left: 1.15em; }
  .resume-duties li + li { margin-top: 4px; }
  .resume-project-context, .resume-research p { margin-top: 5px; }
  .resume-research li + li { margin-top: 16px; }

  @media screen and (max-width: 850px) {
    .resume section { grid-template-columns: minmax(0, 1fr); }
  }
  @media screen and (max-width: 640px) {
    .resume { padding-block: 18px 36px; font-size: 15px; }
    .resume-profile { grid-template-columns: minmax(0, 1fr); padding-block: 32px; }
    .resume-portrait { width: 128px; }
    .resume-facts > div { grid-template-columns: minmax(0, 1fr); }
    .resume-entry { display: block; }
    .resume-entry-meta { display: flex; flex-wrap: wrap; margin-top: 3px; text-align: start; font-size: 13px; }
  }

  @page { size: A4 portrait; margin: 0; }
  @media print {
    .resume-actions { display: none; }
    .resume { width: auto; margin: 0; padding: 0; font-size: 11pt; line-height: 1.4; print-color-adjust: exact; }
    .resume-print-page {
      display: flex;
      flex-direction: column;
      gap: 3.6mm;
      width: 210mm;
      min-height: 296.5mm;
      padding: 11mm 13mm 10mm;
      break-inside: avoid;
    }
    .resume-actions + .resume-print-page { gap: 2.5mm; }
    .resume-print-page + .resume-print-page { break-before: page; }
    .resume-profile { padding: 0; gap: 6mm; break-inside: avoid; }
    .resume-portrait { width: 34mm; border-radius: 2mm; }
    .resume-contact {
      display: flex;
      flex-wrap: wrap;
      gap: 0 4mm;
      margin-top: 2mm;
      font-size: 9.5pt;
    }
    .resume-focus { margin-top: 1mm; }
    .resume-profile-label { margin-bottom: 1.5mm; }
    .resume h1 { font-size: 26pt; }
    .resume-role { font-size: 13pt; margin-top: 1mm; }
    .resume-running { display: flex; font-size: 10pt; }
    .resume section { display: block; padding: 2mm 0 0; break-inside: avoid; }
    .resume h2 { margin-bottom: 2.3mm; font-size: 13pt; break-after: avoid; }
    .resume h2 span, .resume-profile-label { font-size: 9pt; }
    .resume h3 { font-size: 11pt; }
    .resume-entry-meta { grid-template-columns: auto 32mm; font-size: 9.5pt; }
    .resume-timeline { padding-left: 13px; }
    .resume-timeline > li { break-inside: avoid; }
    .resume-timeline > li::before { left: -17px; }
    .resume-timeline > li + li { margin-top: 3mm; }
    .resume-facts { gap: 1mm; }
    .resume-facts > div { grid-template-columns: 32mm minmax(0, 1fr); }
    .resume-duties { margin-top: 1mm; }
    .resume-duties li + li { margin-top: .65mm; }
    .resume-project-context, .resume-research p { margin-top: .7mm; }
    .resume-research li + li { margin-top: 2mm; }
    .resume-folio {
      display: block;
      margin-top: auto;
      padding-top: 1.5mm;
      border-top: 1px solid var(--line);
      color: var(--text-secondary);
      text-align: end;
      font-size: 9pt;
    }
  }
</style>

<style is:global>
  @media print {
    body:has(.resume), body:has(.resume) .site-scroll, body:has(.resume) main {
      display: block;
      height: auto;
      overflow: visible;
      background: white;
    }
    body:has(.resume) :is(.site-dock, .site-brand, .site-footer, .skip-link, .contact-modal) { display: none; }
  }
</style>
