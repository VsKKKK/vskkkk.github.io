---
import SiteLayout from '../../layouts/SiteLayout.astro';
import ProjectHeading from '../../components/ProjectHeading.astro';
import ProjectGallery from '../../components/ProjectGallery.astro';
import projectData from '../../data/projects.json';
import { selectedProjects } from '../../data/selected-projects';

export function getStaticPaths() {
  return projectData.projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props;
const index = selectedProjects.findIndex(({ slug }) => slug === project.slug);
const position = String(index + 1).padStart(2, '0');
const total = String(selectedProjects.length).padStart(2, '0');
const adjacent = [
  { project: selectedProjects[index - 1], direction: 'prev', label: '上一个项目', arrow: '←' },
  { project: selectedProjects[index + 1], direction: 'next', label: '下一个项目', arrow: '→' },
];

---
<SiteLayout description={project.description}>
  <article class="site-shell detail-page">
    <nav class="project-nav-top" aria-label="项目快捷导航">
      <a class="button-pill detail-back" href="/#works">返回</a>
      {index >= 0 && (
        <div class="project-nav-controls">
          <span class="project-nav-index" aria-label={`第 ${index + 1} 个项目，共 ${selectedProjects.length} 个`}>{position} / {total}</span>
          {adjacent.map(({ project, direction, label, arrow }) => project ? (
            <a class="button-pill button-icon project-nav-arrow" href={`/work/${project.slug}/`} rel={direction} aria-label={`${label}：${project.title}`}>{arrow}</a>
          ) : direction === 'next' ? (
            <a class="button-pill button-icon project-nav-arrow" href="/work/ongoing/" aria-label="浏览更多作品">→</a>
          ) : (
            <button class="button-pill button-icon project-nav-arrow" type="button" aria-label={label} disabled>{arrow}</button>
          ))}
        </div>
      )}
    </nav>
    <ProjectHeading project={project} />
    <ProjectGallery images={project.images} />
    <div class="detail-end">
      <a class="button-pill" href="/#works">返回全部作品</a>
      <a class="button-pill" href="#top">回到顶部 <span aria-hidden="true">↑</span></a>
    </div>
  </article>
</SiteLayout>

<style>
  .detail-page { min-width: 0; padding-block-end: clamp(36px, 4vw, 56px); }
  .project-nav-top, .project-nav-controls { display: flex; align-items: center; }
  .project-nav-top { justify-content: space-between; gap: 8px; }
  .project-nav-controls { gap: 8px; }
  .project-nav-index {
    color: var(--text-secondary);
    font-size: 13px;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .project-nav-arrow:disabled { opacity: .5; }
  @media (max-width: 640px) { .project-nav-controls { gap: 4px; } }
</style>
