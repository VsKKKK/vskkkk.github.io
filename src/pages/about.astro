---
import SiteLayout from '../layouts/SiteLayout.astro';
import CopyButton from '../components/CopyButton.astro';
import { Image } from 'astro:assets';
import portrait from '../assets/keyin-portrait.jpg';
import { Watcher } from '../components/eye-tracker/Watcher';
import ResumeContacts from '../components/ResumeContacts.astro';
import { site } from '../data/site';
import { toolkit } from '../data/toolkit';

const intro = [
  '我是一名 UI/UX 产品设计师，参与过 B 端企业平台、数据产品和 C 端移动应用的设计。',
  '熟悉从需求理解、业务梳理、用户研究、信息架构到交互与视觉设计的完整流程，能够结合产品目标与用户场景，梳理复杂信息与操作路径。',
  '我关注产品的易用性、设计一致性与实际落地，希望通过清晰、高效的体验，帮助用户更顺畅地完成任务，让设计真正服务于用户需求与产品目标。',
];

const focusAreas = ['产品设计', '用户体验', '交互设计', '视觉设计', '设计系统', '多端设计'];
const expertise = [
  { id: 'b2b-product', icon: 'layers', title: '产品与业务理解', description: '理解产品目标与业务需求，梳理复杂信息、角色关系及核心任务，形成清晰、合理的产品解决方案。' },
  { id: 'ux-interaction', icon: 'pointer', title: '用户体验与交互', description: '从用户场景出发，构建信息架构、操作流程与交互反馈，关注产品的易用性与操作效率。' },
  { id: 'design-systems', icon: 'component', title: '视觉设计与规范', description: '兼顾界面表现与实际使用体验，通过组件规范、设计系统与视觉统一，提升产品的一致性与可维护性。' },
  { id: 'mobile-app', icon: 'monitor', title: '多端产品设计', description: '具备 Web、移动端 App 等产品设计经验，结合不同设备与使用场景，优化界面布局及交互体验。' },
] as const;
const experience = [
  {
    company: '广州西美信息科技有限公司',
    role: 'UI/UX 设计师',
    period: '2025.09 — 2026.07',
    overview: '参与企业级平台与数据产品设计，负责信息架构、交互界面及设计规范。',
    description: '参与企业级平台与数据产品设计，涉及产业数据平台及企业内容运营管理系统，负责需求理解、信息架构、交互设计、界面设计及设计规范建设。',
    projects: ['CNchemicals · B2B 产业数据平台', 'CAS · 企业内部运营系统'],
    tags: ['企业产品', '数据产品', '设计规范'],
    categories: 'B 端产品、企业系统、数据体验、工作流设计',
  },
  {
    company: '广州奔星网络科技有限公司',
    role: 'UI/UX 设计师',
    period: '2025.03 — 2025.06',
    overview: '参与移动端应用设计，梳理核心功能流程并完成交互和界面设计。',
    description: '参与移动端 App 产品设计，围绕核心功能与用户使用场景，开展产品流程梳理、交互设计及界面视觉设计。',
    projects: ['奔星变声喇叭 App', '移动端产品设计'],
    tags: ['移动应用', '交互设计', '界面设计'],
    categories: '移动端 App、交互设计、界面设计',
  },
  {
    company: '北京伊飒尔界面设计有限公司',
    role: '用户研究员',
    period: '2024.04 — 2025.01',
    overview: '参与移动应用、游戏与汽车项目的用户研究，分析使用场景与体验问题。',
    description: '参与移动应用及不同领域的用户体验研究，涉及 OPPO 天气 App、游戏及汽车相关项目，关注用户需求、产品使用场景与体验问题分析。',
    projects: ['OPPO 天气 App', '王者荣耀体验研究', '腾讯游戏界面研究', '广汽集团用户调研'],
    tags: ['用户研究', '游戏体验', '体验优化'],
    categories: '用户研究、游戏用户体验、体验优化',
  },
];
const icons = {
  layers: 'M12 3 3 8l9 5 9-5-9-5ZM3 12l9 5 9-5M3 16l9 5 9-5',
  monitor: 'M4 4h16v12H4zM12 16v4m-4 0h8',
};
const stepNumber = (index: number) => String(index + 1).padStart(2, '0');
---

<SiteLayout>
  <article class="site-shell about-page">
    <section class="profile" aria-labelledby="about-title" data-eye-tracker-region>
      <div>
        <h1 class="page-title" id="about-title">让设计连接业务需求<br />与用户体验。</h1>
        <div class="profile-copy">
          {intro.map((paragraph) => <p>{paragraph}</p>)}
        </div>
        <a class="button-pill button-primary profile-resume" href="/resume/">查看简历</a>
      </div>
      <aside class="profile-card" aria-label="个人资料">
        <div class="profile-watcher"><Watcher instance="about" size={68} client:visible /></div>
        <div class="profile-portrait">
          <div class="profile-portrait-crop">
            <Image src={portrait} alt="Keyin.li 的个人肖像" format="webp" quality={90}
              width={640} widths={[320, 480, 640]} sizes="260px"
              loading="eager" decoding="async" />
          </div>
        </div>
        <div class="profile-info">
          <h2>{site.name}</h2>
          <p class="profile-role">UI/UX 产品设计师</p>
          <ResumeContacts />
          <p class="profile-direction">B端产品 · C端体验 · 多端设计</p>
          <ul class="profile-details" role="list">
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M19 10c0 5-7 10-7 10s-7-5-7-10a7 7 0 1 1 14 0Z" /><circle cx="12" cy="10" r="2" />
              </svg>
              <span>中国 · 广州</span>
            </li>
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="7" width="18" height="13" rx="2" /><path d="M8 7V5a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2M3 12h18m-11 0v2h4v-2" />
              </svg>
              <span>企业产品 / 消费产品 / 多端设计</span>
            </li>
          </ul>
          <div class="profile-focus">
            <h3>专注领域</h3>
            <ul class="chips" role="list">
              {focusAreas.map(label => <li class="chip">{label}</li>)}
            </ul>
          </div>
        </div>
      </aside>
    </section>

    <section class="about-section" aria-labelledby="expertise-title">
      <h2 id="expertise-title">专业能力</h2>
      <div class="expertise-grid">
        {expertise.map(({ id, icon, title, description }, index) => (
          <div class="expertise-item" id={id} tabindex="-1">
            <span class="expertise-marker" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d={icons[icon]} /></svg>
              <span class="step-number">{stepNumber(index)}</span>
            </span>
            <div>
              <h3>{title}</h3>
              <p>{description}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="about-section" aria-labelledby="experience-title">
      <h2 id="experience-title">工作经历</h2>
      <ol class="timeline" role="list">
        {experience.map(({ company, role, period, overview, description, projects, tags, categories }) => (
          <li class="timeline-item">
            <details>
              <summary>
                <span class="timeline-period">{period}</span>
                <strong>{company}</strong>
                <span class="timeline-role">{role}</span>
                <span class="timeline-overview">{overview}</span>
                <span class="chips timeline-tags">
                  {tags.map(tag => <span class="chip">{tag}</span>)}
                </span>
                <span class="timeline-toggle">
                  <span class="timeline-expand">查看详情</span>
                  <span class="timeline-collapse">收起详情</span>
                  <span class="disclosure-icon" aria-hidden="true"></span>
                </span>
              </summary>
              <div class="timeline-content">
                <p class="experience-description">{description}</p>
                <h3>项目经历</h3>
                <ul class="experience-projects">
                  {projects.map((project) => <li>{project}</li>)}
                </ul>
                <p class="experience-categories">相关分类：{categories}</p>
              </div>
            </details>
          </li>
        ))}
      </ol>
    </section>

    <section class="about-section" aria-labelledby="toolkit-title">
      <h2 id="toolkit-title">工具与技术</h2>
      <div class="toolkit">
        {toolkit.map(({ label, tools }, index) => (
          <div class="toolkit-group">
            <h3><span class="toolkit-index">{stepNumber(index)}</span> {label}</h3>
            <ul class="chips" role="list">
              {tools.map(({ name, logo }) => (
                <li class="chip toolkit-chip">
                  <img src={`/tool-logos/${logo}.svg`} width="20" height="20" alt="" loading="lazy" />
                  {name}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <section class="about-section" aria-labelledby="about-contact-title">
      <h2 id="about-contact-title">联系方式</h2>
      <div>
        <p class="contact-intro">保持联系，一起探索更多设计可能。</p>
        <div class="contact-actions">
          <a class="text-link" href={`mailto:${site.email}`}>{site.email}</a>
          <CopyButton class="button-pill" label="复制邮箱" text={site.email} trackEmail successMessage="邮箱已复制" errorMessage="无法自动复制，请选中邮箱地址手动复制。" />
          <button class="button-pill" type="button" data-wechat-trigger aria-haspopup="dialog" aria-controls="wechat-dialog">微信联系</button>
        </div>
      </div>
    </section>
  </article>
  <dialog class="wechat-dialog" id="wechat-dialog" aria-label="微信联系" aria-describedby="wechat-instruction">
    <form method="dialog">
      <button class="contact-close" type="submit" aria-label="关闭微信二维码" autofocus>×</button>
    </form>
    <img src={site.wechatQr} width="665" height="665" alt="微信联系二维码" loading="lazy" />
    <p id="wechat-instruction">扫码添加微信</p>
  </dialog>
</SiteLayout>

<script>
  import { track } from '../scripts/analytics';

  const wechatTrigger = document.querySelector<HTMLButtonElement>('[data-wechat-trigger]');
  const wechatDialog = document.querySelector<HTMLDialogElement>('#wechat-dialog');

  wechatTrigger?.addEventListener('click', () => {
    if (!wechatDialog) return;
    wechatDialog.showModal();
    track('wechat_open');
  });
  wechatDialog?.addEventListener('close', () => wechatTrigger?.focus({ preventScroll: true }));
  wechatDialog?.addEventListener('click', (event) => {
    if (event.target !== wechatDialog) return;
    const { left, right, top, bottom } = wechatDialog.getBoundingClientRect();
    if (event.clientX < left || event.clientX > right || event.clientY < top || event.clientY > bottom) {
      wechatDialog.close();
    }
  });
</script>

<style>
  .about-page { --about-motion: 220ms; padding-bottom: clamp(48px, 7vw, 96px); }
  .profile {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    align-items: center;
    gap: clamp(22px, 3.6vw, 48px);
    padding-block: clamp(60px, 8vw, 112px);
  }
  .profile .page-title { font-size: clamp(32px, 4vw, 54px); line-height: 1.15; word-break: keep-all; overflow-wrap: anywhere; }
  .profile-copy {
    max-width: 34em;
    margin-top: 22px;
    color: var(--text-secondary);
    font-size: clamp(16px, 1.4vw, 18px);
    line-height: 1.8;
  }
  .profile-copy p + p { margin-top: 12px; }
  .profile-resume { margin-top: 20px; }
  .profile-card {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    gap: 16px;
    padding: clamp(16px, 2vw, 24px);
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: rgb(255 255 255 / 46%);
  }
  .profile-card h2 { font-size: 27px; font-weight: 650; line-height: 1.2; letter-spacing: -.04em; }
  .profile-role { margin-top: 7px; font-size: 15px; font-weight: 600; }
  .profile-direction { margin-top: 6px; color: var(--text-secondary); font-size: 13px; }
  .profile-portrait {
    width: min(210px, 100%);
    margin: 0 auto;
  }
  .profile-watcher {
    position: absolute;
    inset: 20px 20px auto auto;
    width: clamp(64px, 8vw, 68px);
    filter: drop-shadow(0 3px 7px rgb(0 0 0 / 9%));
  }
  .profile-portrait-crop {
    aspect-ratio: 3 / 4;
    overflow: hidden;
    border-radius: var(--radius-media);
  }
  @media (max-width: 640px) {
    .profile-watcher { inset: 10px 10px auto auto; width: 44px; filter: none; }
  }
  @media (max-width: 459px) {
    .profile-portrait { width: min(210px, calc(100% - 76px)); }
  }
  .profile-portrait img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .profile-info { min-width: 0; }
  .profile-details {
    list-style: none;
    margin: 12px 0 0;
    padding: 12px 0 0;
    border-top: 1px solid var(--line);
    display: grid;
    gap: 6px;
    color: var(--text-secondary);
    font-size: 13px;
  }
  .profile-details li { display: flex; gap: 7px; align-items: flex-start; }
  .profile-details svg { width: 15px; height: 15px; flex: none; margin-top: 2px; }
  .profile-focus { margin-top: 16px; }
  .profile-focus .chips { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 6px; }
  .profile-focus .chip { padding-inline: 3px; text-align: center; font-size: var(--text-label-compact-size); }
  @media (min-width: 960px), (min-width: 460px) and (max-width: 760px) {
    .profile-card {
    position: relative; grid-template-columns: minmax(0, 4fr) minmax(0, 5fr); }
  }
  @media (min-width: 460px) and (max-width: 640px) {
    .profile-card { padding-top: 56px; }
  }
  .profile-focus h3 { margin-bottom: 10px; font-size: 14px; font-weight: 600; }
  .chips, .timeline { list-style: none; margin: 0; padding: 0; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .chip {
    padding: 5px 10px;
    border: 1px solid var(--line);
  }

  .about-section {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2.35fr);
    align-items: start;
    gap: clamp(24px, 5vw, 64px);
    padding-block: clamp(42px, 5.4vw, 76px);
    border-top: 1px solid var(--line);
  }
  .about-section h2 {
    font-size: clamp(25px, 2.6vw, 34px);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -.025em;
  }

  .expertise-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px 16px;
  }
  .expertise-item {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-content: start;
    gap: 12px;
    padding: 14px 15px;
    border-radius: var(--radius-card);
    background: rgb(255 255 255 / 46%);
    scroll-margin-block-start: 20px;
  }
  .expertise-item:target { box-shadow: inset 0 0 0 1px var(--accent); }
  .expertise-item h3 { font-size: 16px; font-weight: 600; }
  .expertise-item p { margin-top: 4px; color: var(--text-secondary); font-size: 14px; line-height: 1.65; }
  .step-number, .timeline-period {
    color: var(--text-secondary);
    font-size: 13px;
    font-variant-numeric: tabular-nums;
  }
  .expertise-marker { display: grid; justify-items: center; align-content: start; gap: 4px; padding-top: 2px; }
  .expertise-marker svg {
    width: 17px;
    height: 17px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.65;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .timeline details {
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    transition: background-color var(--about-motion) ease;
  }
  .timeline details[open], .timeline details:hover { background: rgb(255 255 255 / 46%); }
  summary {
    position: relative;
    display: grid;
    align-items: center;
    border-radius: inherit;
    list-style: none;
    cursor: pointer;
  }
  summary::-webkit-details-marker { display: none; }
  .disclosure-icon {
    width: 8px;
    height: 8px;
    border-right: 1px solid currentColor;
    border-bottom: 1px solid currentColor;
    color: var(--text-secondary);
    transform: rotate(45deg);
    transition: transform var(--about-motion) ease;
  }
  details[open] .disclosure-icon { transform: rotate(225deg); }

  @supports (interpolate-size: allow-keywords) and selector(details::details-content) {
    details::details-content {
      interpolate-size: allow-keywords;
      height: 0;
      overflow: clip;
      transition: height var(--about-motion) ease, content-visibility var(--about-motion) allow-discrete;
    }
    details[open]::details-content { height: auto; }
  }

  .timeline {
    --timeline-gap: 14px;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: start;
    gap: var(--timeline-gap);
  }
  .timeline-item { position: relative; min-width: 0; padding-top: 20px; }
  .timeline-item:not(:last-child)::before {
    content: '';
    position: absolute;
    inset: 5px auto auto 50%;
    width: calc(100% + var(--timeline-gap));
    border-top: 1px solid var(--line);
    pointer-events: none;
  }
  .timeline-item::after {
    content: '';
    position: absolute;
    inset: 6px auto auto 50%;
    height: 14px;
    border-left: 1px solid var(--line);
    pointer-events: none;
  }
  .timeline summary::before {
    content: '';
    position: absolute;
    inset: -21px auto auto 50%;
    z-index: 1;
    width: 11px;
    height: 11px;
    border: 2px solid var(--text-secondary);
    border-radius: 50%;
    background: var(--surface-page);
    transform: translateX(-50%);
  }
  .timeline details[open] summary::before { border-color: var(--text-secondary); background: var(--text-secondary); }
  .timeline summary { gap: 4px; padding: 16px; }
  .timeline-role { color: var(--text-secondary); font-size: 14px; }
  .timeline-overview {
    margin-top: 8px;
    color: var(--text-secondary);
    font-size: 14px;
    line-height: 1.55;
  }
  .timeline-tags { gap: 4px; margin-top: 6px; }
  .timeline-tags .chip { padding-inline: 6px; font-size: var(--text-label-compact-size); }
  .timeline-toggle {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
    margin-top: 8px;
    padding-top: 10px;
    border-top: 1px solid var(--line);
    font-size: 13px;
    font-weight: 600;
  }
  .timeline-toggle .disclosure-icon { margin-right: 2px; }
  .timeline-collapse, details[open] .timeline-expand { display: none; }
  details[open] .timeline-collapse { display: inline; }
  .timeline-content { margin: 0 16px; padding: 12px 0 16px; border-top: 1px solid var(--line); }
  .timeline-content h3 { margin: 0 0 6px; font-size: 14px; font-weight: 600; }
  .experience-description { margin-bottom: 12px; color: var(--text-secondary); font-size: 14px; line-height: 1.65; }
  .experience-projects { margin: 0; padding: 0 0 0 18px; font-size: 14px; }
  .experience-categories { margin-top: 10px; font-size: 13px; color: var(--text-secondary); }

  @media (min-width: 641px) {
    .timeline summary { grid-template-rows: auto minmax(3.1em, auto) auto minmax(3lh, auto) minmax(2lh, auto) auto; }
  }

  .toolkit { display: grid; gap: 16px; }
  .toolkit h3 { margin-bottom: 6px; font-size: var(--text-caption-size); font-weight: 600; }
  .toolkit .chips { gap: 6px; }
  .toolkit-chip { display: inline-flex; align-items: center; gap: 6px; padding: 3px 8px; }
  .toolkit-index { color: var(--text-secondary); font-size: var(--text-label-compact-size); font-weight: 500; }
  .toolkit-chip img { display: block; width: 20px; height: 20px; flex: none; object-fit: contain; }

  .contact-intro { margin-bottom: 12px; color: var(--text-secondary); }
  @media (max-width: 760px) {
    .profile { grid-template-columns: minmax(0, 1fr); }
  }
  .contact-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 12px 16px; }
  .contact-actions .button-pill { padding-inline: 14px; border-color: var(--line); background: transparent; }
  .contact-actions .button-pill:hover { background: var(--surface-card); }
  .contact-actions a { overflow-wrap: anywhere; }

  .wechat-dialog {
    width: min(352px, calc(100% - 32px), calc(100dvh - 108px));
    margin: auto;
    padding: 8px 12px 12px;
    border: 0;
    border-radius: var(--radius-card);
    background: var(--surface-card);
    color: var(--text);
  }
  .wechat-dialog::backdrop { background: rgb(0 0 0 / 45%); }
  .wechat-dialog form { display: flex; justify-content: flex-end; margin: 0; }
  .wechat-dialog img { display: block; width: 100%; height: auto; }
  .wechat-dialog p { margin-top: 4px; color: var(--text-secondary); font-size: 14px; text-align: center; }

  @media (max-width: 900px) {
    .about-section { grid-template-columns: minmax(0, 1fr); }
  }
