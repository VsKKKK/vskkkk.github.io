---
import SiteLayout from '../layouts/SiteLayout.astro';
import { site } from '../data/site';

const intro = [
  '我是一名 UI/UX 产品设计师，以 B 端产品设计为主，同时具备移动端 App 设计与用户体验研究经验。',
  '熟悉从业务需求分析、用户研究到信息架构、交互设计与原型验证的完整过程，曾参与 B2B 数据平台、企业运营系统及移动端产品设计。',
  '我关注如何将复杂业务逻辑转化为清晰、高效、易用的产品体验，让设计真正服务于用户任务与业务目标。',
];

const focusAreas = [
  { label: 'Enterprise Product', id: 'b2b-product' },
  { label: 'UX & Interaction', id: 'ux-interaction' },
  { label: 'Design Systems', id: 'design-systems' },
];
const expertise = [
  { id: 'b2b-product', title: 'B端产品设计', description: '理解复杂业务规则，梳理角色权限与业务流程，设计可落地的企业级产品。' },
  { id: 'ux-interaction', title: '用户体验与交互', description: '从用户任务出发，构建清晰的信息架构、操作路径与交互反馈。' },
  { id: 'design-systems', title: '设计系统', description: '沉淀可复用组件、设计规范与交互规则，保持产品体验一致性。' },
  { id: 'mobile-app', title: '移动端产品设计', description: '结合移动端使用场景，设计核心操作路径、页面层级与即时反馈。' },
];
const experience = [
  {
    company: '广州西美信息科技有限公司',
    role: 'UI / UX 设计师',
    period: '2025.09 — 2026.07',
    projects: ['CNchemicals · B2B 产业数据平台', 'CAS · 企业内部运营系统'],
    tags: ['B2B Product', 'Enterprise System', 'Data Experience', 'Workflow Design'],
  },
  {
    company: '广州奔星网络科技有限公司',
    role: 'UI / UX 设计师',
    period: '2025.03 — 2025.06',
    projects: ['奔星变声喇叭 App', '移动端产品设计'],
    tags: ['Mobile App', 'Interaction Design', 'UI Design'],
  },
  {
    company: '北京伊飒尔界面设计有限公司',
    role: 'UX 用户研究员',
    period: '2024.04 — 2025.01',
    projects: ['OPPO 天气 App', '王者荣耀体验研究', '腾讯游戏界面研究', '广汽集团用户调研'],
    tags: ['User Research', 'Game UX', 'Experience Optimization'],
  },
];
const approach = [
  { label: '理解业务', description: '明确业务目标、用户角色和使用场景，厘清设计需要解决的问题及约束。' },
  { label: '梳理结构', description: '梳理信息架构、任务流程和业务规则，定义页面关系与关键状态。' },
  { label: '设计方案', description: '将结构转化为界面和交互原型，通过组件及规范保持体验一致。' },
  { label: '验证落地', description: '用原型验证关键任务，与开发核对交互状态，根据反馈调整方案。' },
];
const toolkit = [
  { label: '设计工具', items: ['Figma', 'Design Systems', 'Prototyping'] },
  { label: 'AI 与开发', items: ['ChatGPT', 'Codex', 'HTML / CSS', 'React', 'Tailwind'] },
];
const stepNumber = (index: number) => String(index + 1).padStart(2, '0');
---

<SiteLayout title="About">
  <article class="site-shell about-page">
    <section class="profile" aria-labelledby="about-title">
      <div>
        <h1 class="page-title" id="about-title">About</h1>
        <div class="profile-copy">
          {intro.map((paragraph) => <p>{paragraph}</p>)}
        </div>
        <a class="button-pill button-primary profile-resume" href="/resume/">查看简历</a>
      </div>
      <aside class="profile-card" aria-label="个人资料">
        <h2>{site.name}</h2>
        <p>UI/UX Product Designer</p>
        <nav class="profile-focus" aria-label="Focus">
          <h3>Focus</h3>
          <ul class="chips" role="list">
            {focusAreas.map(({ label, id }) => (
              <li><a class="button-pill" href={`#${id}`}>{label}</a></li>
            ))}
          </ul>
        </nav>
      </aside>
    </section>

    <section class="about-section" aria-labelledby="expertise-title">
      <h2 id="expertise-title">专业能力</h2>
      <div class="expertise-grid">
        {expertise.map(({ id, title, description }, index) => (
          <div class="expertise-item" id={id} tabindex="-1">
            <span class="step-number" aria-hidden="true">{stepNumber(index)}</span>
            <div>
              <h3>{title}</h3>
              <p>{description}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="about-section" aria-labelledby="experience-title">
      <h2 id="experience-title">工作经历</h2>
      <ol class="timeline" role="list">
        {experience.map(({ company, role, period, projects, tags }) => (
          <li class="timeline-item">
            <details>
              <summary>
                <span class="timeline-period">{period}</span>
                <strong>{company}</strong>
                <span class="timeline-role">{role}</span>
                <span class="disclosure-icon" aria-hidden="true"></span>
              </summary>
              <div class="timeline-content">
                <ul class="experience-projects">
                  {projects.map((project) => <li>{project}</li>)}
                </ul>
                <ul class="chips" role="list">
                  {tags.map((tag) => <li class="chip">{tag}</li>)}
                </ul>
              </div>
            </details>
          </li>
        ))}
      </ol>
    </section>

    <section class="about-section" aria-labelledby="approach-title">
      <h2 id="approach-title">设计方法</h2>
      <div class="approach" data-approach>
        <progress value="1" max={approach.length} aria-label="设计流程进度"></progress>
        <ol class="approach-steps" role="list">
          {approach.map(({ label }, index) => (
            <li>
              <button type="button" aria-pressed={index === 0 ? 'true' : 'false'} aria-controls={`approach-step-${index}`}>
                <span class="step-number">{stepNumber(index)}</span>
                <strong>{label}</strong>
              </button>
            </li>
          ))}
        </ol>
        {approach.map(({ description }, index) => (
          <p class="approach-description" id={`approach-step-${index}`} hidden={index !== 0}>{description}</p>
        ))}
      </div>
    </section>

    <section class="about-section" aria-labelledby="toolkit-title">
      <h2 id="toolkit-title">工具与技术</h2>
      <div class="toolkit">
        {toolkit.map(({ label, items }) => (
          <div class="toolkit-group">
            <h3>{label}</h3>
            <ul class="chips" role="list">
              {items.map((item) => <li class="chip">{item}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <section class="about-section" aria-labelledby="about-contact-title">
      <h2 id="about-contact-title">联系方式</h2>
      <div>
        <div class="contact-actions">
          <a class="text-link" href={`mailto:${site.email}`}>{site.email}</a>
          <button class="button-pill" type="button" data-copy-email={site.email}>复制邮箱</button>
        </div>
        <p class="copy-status" role="status"></p>
      </div>
    </section>
  </article>
</SiteLayout>

<script>
  const approach = document.querySelector('[data-approach]');
  const progress = approach?.querySelector('progress');
  const steps = approach?.querySelectorAll('button[aria-controls]');
  const panels = approach?.querySelectorAll<HTMLElement>('.approach-description');

  steps?.forEach((step, index) => {
    step.addEventListener('click', () => {
      steps.forEach((button) => button.setAttribute('aria-pressed', String(button === step)));
      panels?.forEach((panel, panelIndex) => { panel.hidden = panelIndex !== index; });
      if (progress) progress.value = index + 1;
    });
  });

  const copy = document.querySelector<HTMLButtonElement>('[data-copy-email]');
  const status = document.querySelector('.copy-status');
  copy?.addEventListener('click', async () => {
    const email = copy.dataset.copyEmail;
    if (!email || !status) return;
    try {
      await navigator.clipboard.writeText(email);
      status.textContent = '邮箱已复制';
    } catch {
      status.textContent = '无法自动复制，请选中邮箱地址手动复制。';
    }
  });
</script>

<style>
  .about-page { --about-motion: 220ms; padding-bottom: clamp(48px, 7vw, 96px); }
  .profile {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(30px, 8vw, 112px);
    padding-block: clamp(60px, 8vw, 112px);
  }
  .profile-copy {
    max-width: 34em;
    margin-top: 22px;
    color: var(--text-secondary);
    font-size: clamp(16px, 1.4vw, 18px);
    line-height: 1.8;
  }
  .profile-copy p + p { margin-top: 12px; }
  .profile-resume { margin-top: 20px; }
  .profile-card {
    padding: clamp(22px, 3vw, 32px);
    border-radius: var(--radius-card);
    background: rgb(255 255 255 / 46%);
  }
  .profile-card h2 { font-size: 27px; font-weight: 650; letter-spacing: -.04em; }
  .profile-card p { color: var(--text-secondary); }
  .profile-focus { margin-top: 22px; }
  .profile-focus h3, .toolkit h3 { margin-bottom: 10px; font-size: 14px; font-weight: 600; }
  .chips, .timeline, .approach-steps { list-style: none; margin: 0; padding: 0; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .chip, .profile-focus .button-pill {
    padding: 5px 10px;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    color: var(--text-secondary);
    font-size: 13px;
  }
  .profile-focus .button-pill { min-height: 36px; background: transparent; }
  .profile-focus .button-pill:hover { color: var(--accent); border-color: var(--accent); }

  .about-section {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2.35fr);
    align-items: start;
    gap: clamp(24px, 5vw, 64px);
    padding-block: clamp(42px, 5.4vw, 76px);
    border-top: 1px solid var(--line);
  }
  .about-section h2 {
    font-size: clamp(25px, 2.6vw, 34px);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -.025em;
  }

  .expertise-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px 16px;
  }
  .expertise-item {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-content: start;
    gap: 12px;
    padding: 14px 15px;
    border-radius: var(--radius-card);
    background: rgb(255 255 255 / 46%);
    scroll-margin-block-start: 20px;
  }
  .expertise-item:target { box-shadow: inset 0 0 0 1px var(--accent); }
  .expertise-item h3 { font-size: 16px; font-weight: 600; }
  .expertise-item p { margin-top: 4px; color: var(--text-secondary); font-size: 14px; line-height: 1.65; }
  .step-number, .timeline-period {
    color: var(--text-secondary);
    font-size: 13px;
    font-variant-numeric: tabular-nums;
  }
  .expertise-item .step-number { padding-top: 3px; }

  .timeline details {
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    transition: background-color var(--about-motion) ease;
  }
  .timeline details[open], .timeline details:hover { background: rgb(255 255 255 / 46%); }
  summary {
    position: relative;
    display: grid;
    align-items: center;
    border-radius: inherit;
    list-style: none;
    cursor: pointer;
  }
  summary::-webkit-details-marker { display: none; }
  .disclosure-icon {
    width: 8px;
    height: 8px;
    border-right: 1px solid currentColor;
    border-bottom: 1px solid currentColor;
    color: var(--text-secondary);
    transform: rotate(45deg);
    transition: transform var(--about-motion) ease;
  }
  details[open] .disclosure-icon { transform: rotate(225deg); }

  @supports (interpolate-size: allow-keywords) and selector(details::details-content) {
    details::details-content {
      interpolate-size: allow-keywords;
      height: 0;
      overflow: clip;
      transition: height var(--about-motion) ease, content-visibility var(--about-motion) allow-discrete;
    }
    details[open]::details-content { height: auto; }
  }

  .timeline {
    --timeline-gap: 14px;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: start;
    gap: var(--timeline-gap);
  }
  .timeline-item { position: relative; min-width: 0; padding-top: 20px; }
  .timeline-item:not(:last-child)::before {
    content: '';
    position: absolute;
    inset: 5px auto auto 50%;
    width: calc(100% + var(--timeline-gap));
    border-top: 1px solid var(--line);
    pointer-events: none;
  }
  .timeline-item::after {
    content: '';
    position: absolute;
    inset: 6px auto auto 50%;
    height: 14px;
    border-left: 1px solid var(--line);
    pointer-events: none;
  }
  .timeline summary::before {
    content: '';
    position: absolute;
    inset: -21px auto auto 50%;
    z-index: 1;
    width: 11px;
    height: 11px;
    border: 2px solid var(--text-secondary);
    border-radius: 50%;
    background: var(--surface-page);
    transform: translateX(-50%);
  }
  .timeline details[open] summary::before { border-color: var(--accent); background: var(--accent); }
  .timeline summary { gap: 4px; padding: 16px 43px 16px 16px; }
  .timeline-role { color: var(--text-secondary); font-size: 14px; }
  .timeline .disclosure-icon { position: absolute; inset: 20px 18px auto auto; }
  .timeline-content { padding: 0 16px 16px; }
  .experience-projects { margin: 0 0 12px; padding: 12px 0 0 18px; border-top: 1px solid var(--line); font-size: 14px; }

  .approach { display: grid; gap: 10px; }
  .approach progress {
    display: block;
    width: 100%;
    height: 2px;
    appearance: none;
    border: 0;
    border-radius: var(--radius-pill);
    overflow: hidden;
    background: var(--line);
    color: var(--accent);
  }
  .approach progress::-webkit-progress-bar { background: var(--line); }
  .approach progress::-webkit-progress-value { background: var(--accent); transition: width var(--about-motion) ease; }
  .approach progress::-moz-progress-bar { background: var(--accent); }
  .approach-steps { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8px; }
  .approach-steps button {
    display: grid;
    gap: 4px;
    width: 100%;
    height: 100%;
    padding: 10px 12px;
    border: 0;
    border-radius: 9px;
    background: transparent;
    text-align: start;
    font-size: 14px;
    overflow-wrap: anywhere;
    transition: background-color var(--about-motion) ease;
  }
  .approach-steps button:hover { background: rgb(0 0 0 / 4%); }
  .approach-steps button[aria-pressed='true'] { background: rgb(0 0 0 / 7%); }
  .approach-steps button[aria-pressed='true'] .step-number { color: var(--accent); }
  .approach-description { min-height: 2lh; margin-top: 4px; color: var(--text-secondary); font-size: 15px; line-height: 1.7; }
  .toolkit { display: grid; gap: 20px; }
  .contact-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 12px 16px; }
  .contact-actions .button-pill { padding-inline: 14px; border-color: var(--line); background: transparent; }
  .contact-actions .button-pill:hover { background: var(--surface-card); }
  .contact-actions a { overflow-wrap: anywhere; }
  .copy-status { color: var(--text-secondary); font-size: 14px; }
  .copy-status:not(:empty) { margin-top: 6px; }

  @media (max-width: 900px) {
    .about-section { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 640px) {
    .profile, .expertise-grid, .timeline { grid-template-columns: minmax(0, 1fr); }
    .timeline { --timeline-gap: 12px; }
    .timeline-item { padding: 0 0 0 20px; }
    .timeline-item:not(:last-child)::before {
      inset: 22px auto calc(-22px - var(--timeline-gap)) 5px;
      width: 0;
      border-top: 0;
      border-left: 1px solid var(--line);
    }
    .timeline-item::after { inset: 22px auto auto 6px; width: 14px; height: 0; border: 0; border-top: 1px solid var(--line); }
    .timeline summary::before { inset: 16px auto auto -21px; transform: none; }
    .approach-steps { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (prefers-reduced-motion: reduce) {
    details, details::details-content, .disclosure-icon, .approach-steps button { transition: none; }
    .approach progress::-webkit-progress-value { transition: none; }
  }
</style>
