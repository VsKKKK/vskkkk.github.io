---
import BackToTop from '../components/BackToTop.astro';
import SiteDock from '../components/SiteDock.astro';
import Footer from '../components/Footer.astro';
import ContactModal from '../components/ContactModal.astro';
import Preloader from '../components/Preloader.astro';
import Analytics from '../components/Analytics.astro';
import { site } from '../data/site';
import '../styles/global.css';

interface Props { description?: string; projectSlug?: string }
const { description, projectSlug } = Astro.props;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    {description && <meta name="description" content={description} />}
    <title>{site.title}</title>
    <Analytics projectSlug={projectSlug} />
  </head>
  <body>
    <Preloader />
    <a class="skip-link" href="#main">跳到正文</a>
    <SiteDock />
    <div class="site-scroll" tabindex="0" role="region" aria-label="页面内容">
      <header class="site-brand site-shell" id="top"><a href="/">{site.name}</a></header>
      <main id="main" tabindex="-1"><slot /></main>
      <Footer />
    </div>
    <BackToTop />
    <ContactModal />
  </body>
</html>
