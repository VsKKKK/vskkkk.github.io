---
interface Props {
  project: {
    slug: string;
    title: string;
    tags: string[];
    cover: { src: string; srcset: string; width: number; height: number };
  };
  eager?: boolean;
}
const { project, eager = false } = Astro.props;
const { cover } = project;
---
<article class="project-card">
  <a draggable="false" href={`/work/${project.slug}/`}>
    <div class="project-card-media">
      <img src={cover.src} srcset={cover.srcset}
        sizes="(max-width: 640px) calc(100vw - 38px), (max-width: 1148px) calc(50vw - 46px), 528px"
        width={cover.width} height={cover.height} alt="" loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : undefined}
        decoding="async" draggable="false" />
    </div>
    <div class="project-card-caption">
      <div>
        <h3>{project.title}</h3>
        <ul class="project-card-tags" aria-label="项目主题" role="list">
          {project.tags.map((tag) => <li>{tag}</li>)}
        </ul>
      </div>
      <span aria-hidden="true">↗</span>
    </div>
  </a>
</article>
