---
import previews from '../data/project-previews.json';

interface Props {
  project: { slug: string; title: string; description: string; tags: string[]; cover: string };
  eager?: boolean;
  summary?: string;
  current?: boolean;
  sizes?: string;
}
const { project, eager = false, summary, current = false, sizes = '(max-width: 640px) calc(100vw - 38px), (max-width: 1148px) calc(50vw - 46px), 528px' } = Astro.props;
const variants = previews[project.cover as keyof typeof previews]?.filter(variant => !('galleryOnly' in variant && variant.galleryOnly));
---
<article class="project-card" style={current ? 'box-shadow: inset 0 0 0 1px var(--accent)' : undefined}>
  <a draggable="false" href={`/work/${project.slug}/`} aria-current={current ? 'page' : undefined} data-track-project={project.slug}>
    <slot name="media">
      <div class="project-card-media">
        <img src={variants?.[0].src ?? project.cover}
          srcset={variants?.map(({src, width}) => `${src} ${width}w`).join(', ')}
          sizes={sizes}
          width="1440" height="810" alt="" loading={eager ? 'eager' : 'lazy'}
          fetchpriority={eager ? 'high' : undefined} decoding="async" draggable="false" />
      </div>
    </slot>
    <div class="project-card-caption">
      <h3 class="project-card-title">
        <span class="project-card-title-text">{project.title}</span>
        <span class="project-card-arrow" aria-hidden="true">→</span>
      </h3>
      <p class:list={["project-card-description", { "project-card-summary": summary }]}>{summary ?? project.description}</p>
      <ul class="project-card-tags" aria-label="项目主题" role="list">
        {project.tags.map((tag) => <li>{tag}</li>)}
      </ul>
    </div>
  </a>
  <slot name="controls" />
</article>

<style>
  .project-card-title { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .project-card-title-text { min-width: 0; overflow-wrap: anywhere; }
  .project-card-arrow { flex: none; color: var(--accent); font-size: 22px; line-height: 1; }

  .project-card-description {
    margin-block: 6px 8px;
    color: var(--text-secondary);
    font-size: 14px;
  }
  .project-card-description:not(.project-card-summary) {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
    block-size: 2lh;
  }
  .project-card-summary { min-block-size: 2lh; }
</style>
