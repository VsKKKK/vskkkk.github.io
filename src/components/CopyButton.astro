---
interface Props {
  class: string;
  label: string;
  text?: string;
  sourceId?: string;
  successMessage: string;
  errorMessage: string;
}

const { class: className, label, text, sourceId, successMessage, errorMessage, ...attrs } = Astro.props;
---
<button
  {...attrs}
  class:list={[className, 'copy-button']}
  type="button"
  data-copy-button
  data-copy-text={text}
  data-copy-source={sourceId}
  data-copy-success={successMessage}
  data-copy-error={errorMessage}
  aria-label={label}
>
  <span class="copy-icon" aria-hidden="true">
    <svg data-copy-icon viewBox="0 0 24 24">
      <rect x="8.5" y="8.5" width="11" height="11" rx="3" />
      <path d="M15.5 8.5V7A2.5 2.5 0 0 0 13 4.5H7A2.5 2.5 0 0 0 4.5 7v6A2.5 2.5 0 0 0 7 15.5h1.5" />
    </svg>
    <svg data-copy-check viewBox="0 0 24 24"><path d="m5 12.5 4.5 4.5L19 7.5" /></svg>
  </span>
  <span class="copy-label" data-default-label={label} aria-hidden="true">
    <span class="copy-window" data-copy-window>
      <span class="copy-words" data-copy-words>
        <span>{label}</span>
        <span>已复制</span>
      </span>
    </span>
  </span>
</button>
<span class="visually-hidden" role="status" data-copy-status></span>

<script>
  import { bindCopyButton } from './copy-button';

  document.querySelectorAll<HTMLButtonElement>('[data-copy-button]').forEach(bindCopyButton);
</script>

<style>
  .copy-button { gap: 6px; }
  .copy-button[aria-busy='true'] { cursor: wait; opacity: .65; }
  .copy-icon {
    position: relative;
    flex: none;
    width: 18px;
    height: 18px;
  }
  .copy-icon svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.9;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .copy-icon [data-copy-check] {
    color: var(--copy-success-color, var(--accent));
    opacity: 0;
    stroke-width: 2.4;
  }
  .copy-label {
    display: grid;
    grid-template-columns: max-content;
    white-space: nowrap;
    line-height: 18px;
  }
  .copy-label::before {
    content: attr(data-default-label);
    visibility: hidden;
    grid-area: 1 / 1;
  }
  .copy-window {
    grid-area: 1 / 1;
    justify-self: start;
    inline-size: 100%;
    max-inline-size: 100%;
    block-size: 18px;
    overflow: clip;
  }
  .copy-words {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .copy-words > span { block-size: 18px; }
  [data-copy-state="success"] .copy-words > span:nth-child(2) { color: var(--copy-success-color, var(--accent)); }
  @media (prefers-reduced-motion: no-preference) {
    .copy-button:active { transform: scale(.97); }
  }
</style>
