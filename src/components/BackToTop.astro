<button class="home-back-top floating-glass" type="button" aria-label="返回顶部" data-back-top inert>
  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M12 19V5m-7 7 7-7 7 7" />
  </svg>
</button>

<script>
  const scroll = document.querySelector<HTMLElement>('.site-scroll');
  const button = document.querySelector<HTMLButtonElement>('[data-back-top]');
  const hero = document.querySelector<HTMLElement>('.home-hero');
  const firstAction = hero?.querySelector<HTMLButtonElement>('.home-hero-actions button');

  if (scroll && button) {
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');

    function update() {
      const visible = scroll.scrollTop >= 480;
      button.toggleAttribute('data-visible', visible);
      button.inert = !visible;
    }

    if (hero) {
      const align = () => button.style.setProperty('--back-top-inset', `${innerWidth - hero.getBoundingClientRect().right}px`);
      new ResizeObserver(align).observe(scroll);
      align();
    }

    scroll.addEventListener('scroll', update, { passive: true });
    window.addEventListener('pageshow', update);
    button.addEventListener('click', (event) => {
      scroll.scrollTo({ top: 0, behavior: reducedMotion.matches ? 'instant' : 'smooth' });
      if (event.detail === 0) firstAction?.focus({ preventScroll: true });
    });
    update();
  }
</script>
