---
import previews from '../data/project-previews.json';

interface Board {
  title: string;
  src: string;
  full: string;
  width: number;
  height: number;
}
interface Props {
  images: Board[];
  eagerFirst?: boolean;
}
const { images, eagerFirst = true } = Astro.props;
const sizes = '(max-width: 640px) calc(100vw - 28px), (max-width: 1148px) calc(100vw - 48px), 1100px';
---
<ol class="project-gallery" aria-label="项目画板" role="list" data-gallery>
  {images.map((image, index) => {
    const variants = previews[image.src as keyof typeof previews];
    const priority = eagerFirst && index === 0;
    return (
      <li>
        <a href={image.full} data-board target="_blank" rel="noopener" aria-label={`在新标签页查看原图：${image.title}`}>
          <img src={variants?.[0].src ?? image.src}
            srcset={variants?.map(({src, width}) => `${src} ${width}w`).join(', ')} sizes={variants ? sizes : undefined}
            width={image.width} height={image.height} alt={image.title}
            loading={priority ? 'eager' : 'lazy'} fetchpriority={priority ? 'high' : undefined} decoding="async" />
        </a>
      </li>
    );
  })}
</ol>
